{
  "$schema": "https://wellmanifest.dev/schemas/dsl-manifest/v1",
  "schema": "wellmanifest.dsl/manifest/v1",
  "id": "wellmanifest.status",
  "name": "Wellmanifest status-cycle transitions",
  "version": "0.1.0-dev",
  "status": "experimental",
  "purpose": "Portable propose-only status transitions with deterministic lifecycle projection and runtime-sealed evidence",
  "domain": "status-cycle",
  "owners": [{"kind": "repository", "id": "github:wellmanifest/status", "responsibilities": ["semantics", "validation", "compatibility", "runtime", "security"]}],
