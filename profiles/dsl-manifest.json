  "lifecycle": {"compatibility": "semver", "stability": "experimental", "breaking": "major", "additive": "minor", "fix": "patch"},
  "semantics": {"effectModel": "propose-only", "unknownPolicy": "preserve", "authoritySchema": null},
  "llm": {
    "mode": "bidirectional",
    "requestSchemas": ["https://wellmanifest.com/schemas/status/request.v1.json"],
    "responseSchemas": ["https://wellmanifest.com/schemas/status/candidate.v1.json"],
    "naturalLanguage": "forbidden",
    "sourceSchema": null,
    "decisionProtocol": "dsl-input-output",
    "modelAuthority": "propose-only",
    "strict": true
  },
  "documentation": {"vocabularyKind": "documents", "commandRoot": "docs", "errorRoot": "docs/ERROR", "criticalRoot": "docs/CRITICAL", "commands": [], "errorCodes": [], "criticalCodes": []},
  "findingPolicy": {"schema": "wellmanifest.dsl/findings/v1", "requiredProducers": ["wellmanifest.dsl-check"], "securityProducers": ["wellmanifest.dsl-check"], "blockingSeverities": ["critical"], "requireEvaluable": true, "blockUnresolvedSecurity": true},
  "publicationPolicy": {"declaredTier": "review", "deterministic": true, "independentReview": true, "externalAuthority": false, "runtimeIsolation": false},
  "conformance": {
    "levels": ["manifest", "contract", "runtime", "llm-boundary"],
    "commands": ["python3 standard/status_check.py self-test", "python3 standard/status_check.py validate --file examples/cycle.jsonl"],
    "validExamples": ["examples/cycle.jsonl"],
    "invalidExamples": []
  },
