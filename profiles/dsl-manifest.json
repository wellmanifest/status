  "ownedPaths": ["contracts/**", "grammars/**", "profiles/**", "standard/**", "examples/**"],
  "artifacts": [
    {"path": "contracts/status.contract.json", "role": "normative-source", "digest": "sha256:297dfbc4cdcff2d51d9c940a852d72a4264c178b86e7ba936cfe51a140b79c8b"},
    {"path": "grammars/status-candidate.gbnf", "role": "grammar", "digest": "sha256:9bd9d198e34e44ae2d7d6ef82517f62385faf61fbcd4012b3e3de43dcfe989cc"},
    {"path": "standard/status_check.py", "role": "parser-contract", "digest": "sha256:7cb7648094187f85532b19347c02fa4683af05463b4d35cc6dbc809d70d85ff2"},
