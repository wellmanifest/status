        "running": [
          "waiting",
          "blocked",
          "succeeded",
          "failed",
          "cancelled"
        ],
        "waiting": [
          "running",
          "blocked",
          "cancelled"
        ],
        "blocked": [
          "running",
          "failed",
          "cancelled"
        ],
        "succeeded": [],
        "failed": [],
        "cancelled": []
      }
    },
    "health/v1": {
      "initial": "unknown",
      "states": [
        "unknown",
        "healthy",
        "degraded",
        "unhealthy",
        "ddos_mitigation",
        "maintenance"
      ],
      "terminal": [],
