        "unknown": [
          "healthy",
          "degraded",
          "unhealthy",
          "ddos_mitigation",
          "maintenance"
        ],
        "healthy": [
          "degraded",
          "unhealthy",
          "ddos_mitigation",
          "maintenance"
        ],
        "degraded": [
          "healthy",
          "unhealthy",
